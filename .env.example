# =============================================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env to git (it is in .gitignore).
# On GoDaddy cPanel you can set these in the "Setup Node.js App" UI instead.
# =============================================================================

# ---- Runtime ----
NODE_ENV=production
PORT=3000

# Behind a reverse proxy (GoDaddy/Passenger/Nginx) keep this as 1.
TRUST_PROXY=1

# ---- CORS: comma-separated list of the exact origins of your React site ----
# Include every scheme+host your site is served from.
CORS_ORIGINS=https://www.example.com,https://example.com

# ---- CSRF ----
# Long random secret used to sign anti-CSRF tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CSRF_SECRET=change-me-to-a-64-char-random-hex-string

# ---- ZeptoMail API (Zoho email delivery) ----
# Required for API-only email sending.
ZEPTO_MAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTO_MAIL_TOKEN=your-zeptomail-token

# ---- Mail routing ----
MAIL_FROM=Website <no-reply@example.com>
MAIL_CONTACT_TO=info@example.com
MAIL_CAREERS_TO=careers@example.com

# ---- Uploads ----
MAX_UPLOAD_MB=5

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=50
EMAIL_RATE_LIMIT_MAX=5

# ---- Cloudflare Turnstile (CAPTCHA) ----
# Secret key from dash.cloudflare.com -> Turnstile -> your site.
# The matching SITE key is public and belongs in the frontend app, not here.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ---- SMTP (email transport) ----
# Zoho Mail account for info@vidhrrumaa.com. Never commit this file.
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@vidhrrumaa.com
SMTP_PASS=your-smtp-password
